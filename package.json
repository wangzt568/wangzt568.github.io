    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "valaxy": "1.1.0",
    "valaxy-theme-yun": "1.1.0",
    "vue": "^3.5.41",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "linkedom": "^0.18.12",
    "feed": "^5.1.0",
    "gray-matter": "^4.0.3"
  }
}
