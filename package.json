{
  "name": "zetiannotes",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "valaxy build --ssg",
    "build:spa": "valaxy build",
    "build:ssg": "valaxy build --ssg",
    "dev": "valaxy",
    "rss": "valaxy rss",
    "serve": "vite preview",
    "preview": "vite preview",
    "migrate:hexo": "python3 scripts/extract-hexo.py && node scripts/convert-hexo.mjs",
    "check:migration": "node scripts/check-migration.mjs",
